{
  "permissions": {
    "additionalDirectories": ["../promotions-service"],
    "deny": [
      "Bash(npm test*)",
      "Bash(npm t)",
      "Bash(npm t *)",
      "Bash(npm run test*)",
      "Bash(npx jest*)",
      "Bash(npx vitest*)",
      "Bash(npx mocha*)",
      "Bash(npx playwright test*)",
      "Bash(node --test*)",
      "Bash(NODE_ENV=test *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-tests.sh"
          }
        ]
      }
    ]
  }
}
