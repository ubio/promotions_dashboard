MONGODB_URI=
GOOGLE_OAUTH_CLIENT_ID=
ALLOWED_EMAIL_DOMAINS=automation.cloud,ub.io,ubio.ai
# openssl rand -hex 32
JWT_SECRET=
# Client portal access: map sign-in email domains to the clientId whose data
# those users may see. Example: CLIENT_EMAIL_DOMAINS=ziffdavis.com:ZiffDavis
CLIENT_EMAIL_DOMAINS=
# Same, for single addresses on a domain we would not grant wholesale
# (e.g. a personal account used to check what a client sees). An exact
# address here is matched before any domain rule.
# Example: CLIENT_EMAIL_ALLOWLIST=someone@gmail.com:ZiffDavis
CLIENT_EMAIL_ALLOWLIST=
# Set to "true" to skip login entirely — LOCAL DEVELOPMENT ONLY
# AUTH_DISABLED=true
# When auth is disabled, simulate a client session (fenced to /portal):
# LOCAL_DEV_ROLE=client
# LOCAL_DEV_CLIENT_ID=DevClient

# Revenue estimate: USD per promotion sent to the client, per client
# CLIENT_VALIDATION_RATES=ZiffDavis:0.25,Atoll:0.30
# DEFAULT_VALIDATION_RATE=0.25

# Secret ops page (internal users only): /secret
# PROMOTIONS_SERVICE_URL=http://localhost:8088
# OPS_SECRET=  (must match promotions-service; protects /Ops/* API endpoints)
